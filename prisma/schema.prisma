generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id               String            @id @default(uuid())
  email            String            @unique @db.VarChar(255)
  password         String            @db.VarChar(255)
  role             role              @default(PATIENT)
  profile_picture  String?           @db.VarChar(255)
  is_active        Boolean?          @default(true)
  created_at       DateTime?         @default(now()) @db.Timestamp(6)
  updated_at       DateTime?         @db.Timestamp(6)
  check_ins        check_ins[]
  doctors          doctors?
  notifications    notifications[]
  patient_profiles patient_profiles?
  payment_proofs   payment_proofs[]
  staff_profiles   staff_profiles?

  @@map("users")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model appointments {
  id                    BigInt               @id @default(autoincrement())
  patient_id            BigInt
  doctor_id             BigInt
  session_id            BigInt
  treatment_id          BigInt
  patient_membership_id BigInt?
  appointment_code      String               @unique @db.VarChar(50)
  consultation_fee      Decimal              @db.Decimal(12, 2)
  treatment_fee         Decimal              @db.Decimal(12, 2)
  discount_amount       Decimal              @default(0) @db.Decimal(12, 2)
  total_amount          Decimal              @db.Decimal(12, 2)
  appointment_status    appointment_status   @default(pending)
  payment_status        payment_status       @default(unpaid)
  payment_deadline      DateTime?            @db.Timestamp(6)
  queue_number          Int?
  checked_in_at         DateTime?            @db.Timestamp(6)
  qr_token              String?              @unique @db.VarChar(255)
  created_at            DateTime?            @default(now()) @db.Timestamp(6)
  updated_at            DateTime?            @db.Timestamp(6)
  doctors               doctors              @relation(fields: [doctor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient_profiles      patient_profiles     @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient_memberships   patient_memberships? @relation(fields: [patient_membership_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  practice_sessions     practice_sessions    @relation(fields: [session_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  treatments            treatments           @relation(fields: [treatment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  check_ins             check_ins?
  payment_proofs        payment_proofs[]
  ratings               ratings?

  @@unique([session_id, queue_number])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model check_ins {
  id             BigInt          @id @default(autoincrement())
  appointment_id BigInt          @unique
  checked_in_by  BigInt
  checked_in_at  DateTime?       @default(now()) @db.Timestamp(6)
  status         checkin_status? @default(checked_in)
  appointments   appointments    @relation(fields: [appointment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users          user            @relation(fields: [checked_in_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model doctor_treatments {
  id           BigInt     @id @default(autoincrement())
  doctor_id    BigInt
  treatment_id BigInt
  doctors      doctors    @relation(fields: [doctor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  treatments   treatments @relation(fields: [treatment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([doctor_id, treatment_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model doctors {
  id                BigInt              @id @default(autoincrement())
  user_id           BigInt              @unique
  name              String              @db.VarChar(150)
  bio               String?
  experience_years  Int?                @default(0)
  consultation_fee  Decimal             @default(0) @db.Decimal(12, 2)
  photo             String?             @db.VarChar(255)
  is_active         Boolean?            @default(true)
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  updated_at        DateTime?           @db.Timestamp(6)
  appointments      appointments[]
  doctor_treatments doctor_treatments[]
  users             user                @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  practice_sessions practice_sessions[]
  ratings           ratings[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model membership_plans {
  id                  BigInt                @id @default(autoincrement())
  name                String                @unique @db.VarChar(100)
  description         String?
  price               Decimal               @db.Decimal(12, 2)
  duration_days       Int
  discount_percent    Decimal               @default(0) @db.Decimal(5, 2)
  is_active           Boolean?              @default(true)
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  updated_at          DateTime?             @db.Timestamp(6)
  patient_memberships patient_memberships[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model notifications {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  title      String    @db.VarChar(150)
  message    String
  type       String?   @db.VarChar(50)
  is_read    Boolean?  @default(false)
  sent_at    DateTime? @default(now()) @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      user      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model patient_memberships {
  id               BigInt            @id @default(autoincrement())
  patient_id       BigInt
  plan_id          BigInt
  start_date       DateTime          @db.Date
  end_date         DateTime          @db.Date
  price_paid       Decimal           @db.Decimal(12, 2)
  status           membership_status @default(pending)
  created_at       DateTime?         @default(now()) @db.Timestamp(6)
  updated_at       DateTime?         @db.Timestamp(6)
  appointments     appointments[]
  patient_profiles patient_profiles  @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  membership_plans membership_plans  @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model patient_profiles {
  id                  BigInt                @id @default(autoincrement())
  user_id             BigInt                @unique
  full_name           String                @db.VarChar(150)
  phone_number        String?               @db.VarChar(20)
  date_of_birth       DateTime?             @db.Date
  gender              gender_type?
  address             String?
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  updated_at          DateTime?             @db.Timestamp(6)
  appointments        appointments[]
  patient_memberships patient_memberships[]
  users               user                  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ratings             ratings[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model payment_proofs {
  id                  BigInt               @id @default(autoincrement())
  appointment_id      BigInt
  image_url           String               @db.VarChar(255)
  uploaded_at         DateTime?            @default(now()) @db.Timestamp(6)
  verified_at         DateTime?            @db.Timestamp(6)
  verified_by         BigInt?
  verification_status verification_status? @default(pending)
  rejection_reason    String?
  appointments        appointments         @relation(fields: [appointment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users               user?                @relation(fields: [verified_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model practice_sessions {
  id             BigInt          @id @default(autoincrement())
  doctor_id      BigInt
  session_date   DateTime        @db.Date
  start_time     DateTime        @db.Time(6)
  end_time       DateTime        @db.Time(6)
  patient_quota  Int
  status         session_status? @default(scheduled)
  created_at     DateTime?       @default(now()) @db.Timestamp(6)
  updated_at     DateTime?       @db.Timestamp(6)
  appointments   appointments[]
  doctors        doctors         @relation(fields: [doctor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  session_queues session_queues?

  @@unique([doctor_id, session_date, start_time])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ratings {
  id               BigInt           @id @default(autoincrement())
  appointment_id   BigInt           @unique
  patient_id       BigInt
  doctor_id        BigInt
  rating           Int              @db.SmallInt
  review           String?
  created_at       DateTime?        @default(now()) @db.Timestamp(6)
  updated_at       DateTime?        @db.Timestamp(6)
  appointments     appointments     @relation(fields: [appointment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  doctors          doctors          @relation(fields: [doctor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient_profiles patient_profiles @relation(fields: [patient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model session_queues {
  id                BigInt            @id @default(autoincrement())
  session_id        BigInt            @unique
  current_number    Int?              @default(0)
  last_queue_number Int?              @default(0)
  updated_at        DateTime?         @db.Timestamp(6)
  practice_sessions practice_sessions @relation(fields: [session_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model staff_profiles {
  id           BigInt    @id @default(autoincrement())
  user_id      BigInt    @unique
  full_name    String    @db.VarChar(150)
  phone_number String?   @db.VarChar(20)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @db.Timestamp(6)
  users        user      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model treatments {
  id                BigInt              @id @default(autoincrement())
  name              String              @db.VarChar(150)
  description       String?
  price             Decimal             @db.Decimal(12, 2)
  duration_minutes  Int
  image             String?             @db.VarChar(255)
  is_active         Boolean?            @default(true)
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  updated_at        DateTime?           @db.Timestamp(6)
  appointments      appointments[]
  doctor_treatments doctor_treatments[]
}

enum role {
  PATIENT
  ADMIN
  STAFF
  DOCTOR
}

enum appointment_status {
  pending
  confirmed
  checked_in
  in_progress
  completed
  canceled
  no_show
}

enum checkin_status {
  checked_in
  no_show
}

enum gender_type {
  male
  female
  other
}

enum membership_status {
  pending
  active
  expired
  canceled
}

enum payment_status {
  unpaid
  pending_verification
  paid
  rejected
  expired
}

enum session_status {
  scheduled
  ongoing
  completed
  canceled
}

enum verification_status {
  pending
  approved
  rejected
}

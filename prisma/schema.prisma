generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id               String            @id @default(uuid())
  phone_number     String            @unique @db.VarChar(20)
  email            String            @unique @db.VarChar(255)
  full_name        String            @db.VarChar(150)
  password         String            @db.VarChar(255)
  role             role              @default(PATIENT)
  profile_picture  String?           @db.VarChar(255)
  is_active        Boolean           @default(true)
  created_at       DateTime          @default(now()) @db.Timestamp(6)
  updated_at       DateTime          @updatedAt @db.Timestamp(6)
  check_ins        check_ins[]
  doctors          doctors?
  notifications    notifications[]
  patient_profiles patient_profiles?
  payment_proofs   payment_proofs[]
  staff_profiles   staff_profiles?

  @@index([role, is_active])
  @@map("users")
}

model appointments {
  id                    String               @id @default(uuid())
  patient_id            String
  doctor_id             String
  session_id            String
  treatment_id          String
  patient_membership_id String?
  appointment_code      String               @unique @db.VarChar(50)
  consultation_fee      Decimal              @db.Decimal(12, 2)
  treatment_fee         Decimal              @db.Decimal(12, 2)
  discount_amount       Decimal              @default(0) @db.Decimal(12, 2)
  total_amount          Decimal              @db.Decimal(12, 2)
  // 6 status transaksi sesuai requirement (menggantikan appointment_status + payment_status)
  status                transaction_status   @default(waiting_payment)
  payment_deadline      DateTime?            @db.Timestamp(6)
  queue_number          Int?
  checked_in_at         DateTime?            @db.Timestamp(6)
  qr_token              String?              @unique @db.VarChar(255)
  created_at            DateTime             @default(now()) @db.Timestamp(6)
  updated_at            DateTime             @updatedAt @db.Timestamp(6)
  doctors               doctors              @relation(fields: [doctor_id], references: [id], onDelete: Restrict)
  patient_profiles      patient_profiles     @relation(fields: [patient_id], references: [id], onDelete: Restrict)
  patient_memberships   patient_memberships? @relation(fields: [patient_membership_id], references: [id], onDelete: SetNull)
  practice_sessions     practice_sessions    @relation(fields: [session_id], references: [id], onDelete: Restrict)
  treatments            treatments           @relation(fields: [treatment_id], references: [id], onDelete: Restrict)
  check_ins             check_ins?
  payment_proofs        payment_proofs[]
  ratings               ratings?

  @@unique([session_id, queue_number])
  @@index([patient_id, status])
  @@index([doctor_id, status])
  @@index([session_id])
  @@index([treatment_id])
  @@index([patient_membership_id])
  @@index([status, payment_deadline])
}

model check_ins {
  id             String         @id @default(uuid())
  appointment_id String         @unique
  checked_in_by  String
  checked_in_at  DateTime       @default(now()) @db.Timestamp(6)
  status         checkin_status @default(checked_in)
  appointments   appointments   @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  users          user           @relation(fields: [checked_in_by], references: [id], onDelete: Restrict)

  @@index([checked_in_by])
}

model doctor_treatments {
  id           String     @id @default(uuid())
  doctor_id    String
  treatment_id String
  doctors      doctors    @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  treatments   treatments @relation(fields: [treatment_id], references: [id], onDelete: Cascade)

  @@unique([doctor_id, treatment_id])
  @@index([treatment_id])
}

model doctors {
  id                String              @id @default(uuid())
  user_id           String              @unique
  full_name         String              @db.VarChar(150)
  bio               String?
  experience_years  Int                 @default(0)
  consultation_fee  Decimal             @default(0) @db.Decimal(12, 2)
  photo             String?             @db.VarChar(255)
  specialist_id     String?
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamp(6)
  updated_at        DateTime            @updatedAt @db.Timestamp(6)
  appointments      appointments[]
  doctor_schedules  doctor_schedules[]
  doctor_treatments doctor_treatments[]
  users             user                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  specialists       specialists?        @relation(fields: [specialist_id], references: [id], onDelete: Restrict)
  practice_sessions practice_sessions[]
  ratings           ratings[]

  @@index([is_active])
  @@index([specialist_id])
}

// Jadwal praktik mingguan; sesi per tanggal dibuat dari sini saat booking pertama
model doctor_schedules {
  id            String   @id @default(uuid())
  doctor_id     String
  day_of_week   Int      @db.SmallInt // 0 = Minggu ... 6 = Sabtu
  start_time    DateTime @db.Time(6)
  end_time      DateTime @db.Time(6)
  patient_quota Int
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)
  doctors       doctors  @relation(fields: [doctor_id], references: [id], onDelete: Cascade)

  @@unique([doctor_id, day_of_week, start_time])
  @@index([day_of_week, is_active])
}

model specialists {
  id          String    @id @default(uuid())
  name        String    @unique @db.VarChar(100)
  description String?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime  @updatedAt @db.Timestamp(6)
  doctors     doctors[]

  @@index([is_active])
}

model membership_plans {
  id                  String                @id @default(uuid())
  user_id             String                @unique @db.VarChar(100)
  description         String?
  price               Decimal               @db.Decimal(12, 2)
  duration_days       Int
  discount_percent    Decimal               @default(0) @db.Decimal(5, 2)
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime              @updatedAt @db.Timestamp(6)
  patient_memberships patient_memberships[]
}

model notifications {
  id         String   @id @default(uuid())
  user_id    String
  title      String   @db.VarChar(150)
  message    String
  type       String?  @db.VarChar(50)
  is_read    Boolean  @default(false)
  sent_at    DateTime @default(now()) @db.Timestamp(6)
  created_at DateTime @default(now()) @db.Timestamp(6)
  users      user     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read, created_at])
}

model patient_memberships {
  id               String            @id @default(uuid())
  patient_id       String
  plan_id          String
  start_date       DateTime          @db.Date
  end_date         DateTime          @db.Date
  price_paid       Decimal           @db.Decimal(12, 2)
  status           membership_status @default(pending)
  created_at       DateTime          @default(now()) @db.Timestamp(6)
  updated_at       DateTime          @updatedAt @db.Timestamp(6)
  appointments     appointments[]
  patient_profiles patient_profiles  @relation(fields: [patient_id], references: [id], onDelete: Restrict)
  membership_plans membership_plans  @relation(fields: [plan_id], references: [id], onDelete: Restrict)

  @@index([patient_id, status])
  @@index([plan_id])
  @@index([end_date])
}

model patient_profiles {
  id                  String                @id @default(uuid())
  user_id             String                @unique
  date_of_birth       DateTime?             @db.Date
  gender              gender_type?
  address             String?
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime              @updatedAt @db.Timestamp(6)
  appointments        appointments[]
  patient_memberships patient_memberships[]
  users               user                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  ratings             ratings[]
}

model payment_proofs {
  id                  String              @id @default(uuid())
  appointment_id      String
  image_url           String              @db.VarChar(255)
  uploaded_at         DateTime            @default(now()) @db.Timestamp(6)
  verified_at         DateTime?           @db.Timestamp(6)
  verified_by         String?
  verification_status verification_status @default(pending)
  rejection_reason    String?
  appointments        appointments        @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  users               user?               @relation(fields: [verified_by], references: [id], onDelete: SetNull)

  @@index([appointment_id])
  @@index([verified_by])
  @@index([verification_status])
}

model practice_sessions {
  id             String          @id @default(uuid())
  doctor_id      String
  session_date   DateTime        @db.Date
  start_time     DateTime        @db.Time(6)
  end_time       DateTime        @db.Time(6)
  patient_quota  Int
  status         session_status  @default(scheduled)
  created_at     DateTime        @default(now()) @db.Timestamp(6)
  updated_at     DateTime        @updatedAt @db.Timestamp(6)
  appointments   appointments[]
  doctors        doctors         @relation(fields: [doctor_id], references: [id], onDelete: Restrict)
  session_queues session_queues?

  @@unique([doctor_id, session_date, start_time])
  @@index([session_date, status])
}

model ratings {
  id               String           @id @default(uuid())
  appointment_id   String           @unique
  patient_id       String
  doctor_id        String
  rating           Int              @db.SmallInt
  review           String?
  created_at       DateTime         @default(now()) @db.Timestamp(6)
  updated_at       DateTime         @updatedAt @db.Timestamp(6)
  appointments     appointments     @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  doctors          doctors          @relation(fields: [doctor_id], references: [id], onDelete: Restrict)
  patient_profiles patient_profiles @relation(fields: [patient_id], references: [id], onDelete: Restrict)

  @@index([doctor_id])
  @@index([patient_id])
}

model session_queues {
  id                String            @id @default(uuid())
  session_id        String            @unique
  current_number    Int               @default(0)
  last_queue_number Int               @default(0)
  updated_at        DateTime          @updatedAt @db.Timestamp(6)
  practice_sessions practice_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade)
}

model staff_profiles {
  id         String   @id @default(uuid())
  user_id    String   @unique
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)
  users      user     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model treatments {
  id                String              @id @default(uuid())
  // Sama dengan slug di halaman /treatment/[treatmentSlug] (frontend)
  slug              String?             @unique @db.VarChar(150)
  name              String              @db.VarChar(150)
  description       String?
  price             Decimal             @db.Decimal(12, 2)
  duration_minutes  Int
  image             String?             @db.VarChar(255)
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamp(6)
  updated_at        DateTime            @updatedAt @db.Timestamp(6)
  appointments      appointments[]
  doctor_treatments doctor_treatments[]

  @@index([is_active])
}

enum role {
  PATIENT
  ADMIN
  STAFF
  DOCTOR
}

enum transaction_status {
  waiting_payment
  waiting_confirmation
  done
  rejected
  expired
  canceled
}

enum checkin_status {
  checked_in
  no_show
}

enum gender_type {
  male
  female
  other
}

enum membership_status {
  pending
  active
  expired
  canceled
}

enum session_status {
  scheduled
  ongoing
  completed
  canceled
}

enum verification_status {
  pending
  approved
  rejected
}
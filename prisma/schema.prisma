generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS (Sesuai dengan database Supabase di clinic-appointment-platform)
// =============================================================================

enum user_role {
  patient
  admin
}

enum gender {
  male
  female
  other
}

enum transaction_status {
  waiting_payment
  waiting_confirmation
  done
  rejected
  expired
  canceled
}

enum checkin_status {
  checked_in
  no_show
}

enum role {
  PATIENT
  ADMIN
  STAFF
  DOCTOR
}

// =============================================================================
// 1. CORE SUPABASE MODELS (1:1 dengan supabase/migrations/20261103000000_init_schema.sql)
// =============================================================================

/// Profil pengguna 1:1 dengan auth.users Supabase
model profiles {
  id            String         @id @db.Uuid
  role          user_role      @default(patient)
  full_name     String         @default("")
  phone_number  String?
  avatar_url    String?
  date_of_birth DateTime?      @db.Date
  gender        gender?
  address       String?
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  appointments  appointments[]
  ratings       ratings[]

  @@map("profiles")
}

/// Bidang spesialisasi medis klinik
model specialists {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  doctors     doctors[]

  @@map("specialists")
}

/// Dokter klinik estetika
model doctors {
  id                String              @id @default(uuid()) @db.Uuid
  specialist_id     String?             @db.Uuid
  full_name         String              @db.VarChar(150)
  bio               String?
  experience_years  Int                 @default(0)
  consultation_fee  Decimal             @db.Decimal(12, 0)
  photo_url         String?             @db.VarChar(255)
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  specialists       specialists?        @relation(fields: [specialist_id], references: [id], onDelete: SetNull)
  doctor_schedules  doctor_schedules[]
  practice_sessions practice_sessions[]
  appointments      appointments[]
  ratings           ratings[]

  @@index([is_active])
  @@index([specialist_id])
  @@map("doctors")
}

/// Jadwal praktik mingguan dokter (template)
model doctor_schedules {
  id                String              @id @default(uuid()) @db.Uuid
  doctor_id         String              @db.Uuid
  day_of_week       Int                 @db.SmallInt // 0 = Minggu ... 6 = Sabtu
  start_time        DateTime            @db.Time(6)
  end_time          DateTime            @db.Time(6)
  patient_quota     Int
  is_active         Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  doctors           doctors             @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  practice_sessions practice_sessions[]

  @@unique([doctor_id, day_of_week, start_time])
  @@index([day_of_week, is_active])
  @@map("doctor_schedules")
}

/// Sesi praktik nyata di satu tanggal kalender
model practice_sessions {
  id                   String            @id @default(uuid()) @db.Uuid
  doctor_id            String            @db.Uuid
  schedule_id          String?           @db.Uuid
  session_date         DateTime          @db.Date
  start_time           DateTime          @db.Time(6)
  end_time             DateTime          @db.Time(6)
  starts_at            DateTime?         @db.Timestamptz(6)
  ends_at              DateTime?         @db.Timestamptz(6)
  patient_quota        Int
  current_queue_number Int               @default(0)
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  doctors              doctors           @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  doctor_schedules     doctor_schedules? @relation(fields: [schedule_id], references: [id], onDelete: SetNull)
  appointments         appointments[]

  @@unique([doctor_id, session_date, start_time])
  @@index([session_date])
  @@map("practice_sessions")
}

/// Janji temu / Reservasi pasien
model appointments {
  id                  String             @id @default(uuid()) @db.Uuid
  code                String             @unique
  patient_id          String             @db.Uuid
  doctor_id           String             @db.Uuid
  session_id          String             @db.Uuid
  status              transaction_status @default(waiting_payment)
  consultation_fee    Decimal            @db.Decimal(12, 0)
  payment_deadline    DateTime           @db.Timestamptz(6)
  payment_proof_path  String?
  payment_uploaded_at DateTime?          @db.Timestamptz(6)
  rejection_reason    String?
  confirmed_at        DateTime?          @db.Timestamptz(6)
  booking_number      Int?
  qr_token            String?            @unique @db.Uuid
  checked_in_at       DateTime?          @db.Timestamptz(6)
  queue_number        Int?
  is_no_show          Boolean            @default(false)
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  updated_at          DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  profiles            profiles           @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  doctors             doctors            @relation(fields: [doctor_id], references: [id])
  practice_sessions   practice_sessions  @relation(fields: [session_id], references: [id])
  ratings             ratings?

  @@unique([session_id, queue_number])
  @@index([patient_id, status])
  @@index([doctor_id, status])
  @@index([session_id])
  @@index([status, payment_deadline])
  @@map("appointments")
}

/// Rating dan ulasan pasien terhadap dokter
model ratings {
  id             String       @id @default(uuid()) @db.Uuid
  appointment_id String       @unique @db.Uuid
  patient_id     String       @db.Uuid
  doctor_id      String       @db.Uuid
  rating         Int          @db.SmallInt
  review         String?
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  appointments   appointments @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  profiles       profiles     @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  doctors        doctors      @relation(fields: [doctor_id], references: [id], onDelete: Cascade)

  @@index([doctor_id])
  @@index([patient_id])
  @@map("ratings")
}

// =============================================================================
// 2. MODEL TAMBAHAN / BACKWARD COMPATIBILITY DENGAN SCRIPT LOKAL
// =============================================================================

model user {
  id              String   @id @default(uuid())
  email           String   @unique @db.VarChar(255)
  full_name       String   @db.VarChar(150)
  password        String   @db.VarChar(255)
  phone_number    String   @unique @db.VarChar(20)
  role            role     @default(PATIENT)
  profile_picture String?  @db.VarChar(255)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @updatedAt @db.Timestamp(6)

  @@index([role, is_active])
  @@map("users")
}

model treatments {
  id               String   @id @default(uuid())
  slug             String?  @unique @db.VarChar(150)
  name             String   @db.VarChar(150)
  description      String?
  price            Decimal  @db.Decimal(12, 2)
  duration_minutes Int
  image            String?  @db.VarChar(255)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamp(6)
  updated_at       DateTime @updatedAt @db.Timestamp(6)

  @@index([is_active])
  @@map("treatments")
}

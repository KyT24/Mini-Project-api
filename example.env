# =============================================================================
# ARHE Clinic Appointment API - Example Environment Configuration
# Salin file ini menjadi .env lalu sesuaikan nilainya: cp example.env .env
# =============================================================================

# ---------- Aplikasi ----------
NODE_ENV=DEVELOPMENT
PORT=8000
API_PREFIX=/api/v1
# Origin frontend yang diizinkan mengakses API (CORS), pisahkan dengan koma atau gunakan *
ALLOWED_ORIGINS=http://localhost:3000

# ---------- Database (PostgreSQL / Supabase) ----------
# Lokal Docker/Postgres:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Atau Supabase Cloud (Wajib untuk Vercel / Serverless Deployment):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ---------- Auth ----------
# Secret key untuk verifikasi & generate JWT token (contoh: openssl rand -hex 32)
JWT_SECRET_KEY=your-32-byte-jwt-secret-key-min-32-characters

# ---------- Supabase Project & Auth/Storage ----------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Nama bucket storage Supabase (doctor-photos publik, payment-proofs privat)
SUPABASE_BUCKET_DOCTOR_PHOTOS=doctor-photos
SUPABASE_BUCKET_PAYMENT_PROOFS=payment-proofs

# (Opsional) Alias Next.js jika frontend di-import ke backend
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ---------- Akun Seed Admin Default ----------
# Digunakan untuk inisialisasi akun admin pertama via: npm run seed:admin
ADMIN_EMAIL=admin@klinik.test
ADMIN_PASSWORD=Admin123!
ADMIN_FULL_NAME="Admin Utama Klinik Estetika"
ADMIN_PHONE=081234567890

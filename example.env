# =============================================================================
# ARHE Clinic Appointment API - Example Environment Configuration
# Salin file ini menjadi .env lalu sesuaikan nilainya: cp example.env .env
# =============================================================================

# ---------- Aplikasi ----------
NODE_ENV='DEVELOPMENT'
PORT=8000
API_PREFIX=/api/v1
# URL frontend yang boleh mengakses API (CORS)
ALLOWED_ORIGINS=http://localhost:3000

# ---------- Database (PostgreSQL / Supabase) ----------
# Dipakai Prisma Client & prisma migrate (prisma7.config.ts)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# ---------- Auth ----------
# String acak panjang, mis. hasil: openssl rand -hex 32
JWT_SECRET_KEY=94c502da5df3890f666f358ad7d9ba66723b7b4a20b0ddf5170d47aa28f747eb

# ---------- Supabase Project & Storage (disalin dari frontend .env) ----------
SUPABASE_URL=https://wewieruvgvxupjndagnb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_publishable_zdn0kiwPWaQXJciMAhVjFg_VbsdN6Eg
SUPABASE_ANON_KEY=sb_publishable_zdn0kiwPWaQXJciMAhVjFg_VbsdN6Eg

# Alias Next.js
NEXT_PUBLIC_SUPABASE_URL=https://wewieruvgvxupjndagnb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_zdn0kiwPWaQXJciMAhVjFg_VbsdN6Eg

# Bucket storage publik
SUPABASE_BUCKET=payment-proofs

# ---------- Akun Seed Admin Default ----------

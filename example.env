# Salin file ini menjadi .env lalu isi nilainya: cp example.env .env

# ---------- Aplikasi ----------
# DEVELOPMENT = server jalan via app.listen; PRODUCTION = CORS dibatasi ALLOWED_ORIGINS
NODE_ENV='DEVELOPMENT'
PORT=8000
API_PREFIX=/api/v1
# URL frontend yang boleh mengakses API (pisahkan dengan koma), wajib saat PRODUCTION
ALLOWED_ORIGINS=http://localhost:3000

# ---------- Database (PostgreSQL / Supabase) ----------
# Dipakai Prisma Client & prisma migrate (prisma7.config.ts)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# Opsional: koneksi langsung Supabase (non-pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---------- Auth ----------
# String acak panjang, mis. hasil: openssl rand -hex 32
JWT_SECRET_KEY=

# ---------- Supabase Storage (upload bukti bayar & foto dokter) ----------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Service role key: hanya untuk server, jangan pernah dipakai di frontend
SUPABASE_SERVICE_ROLE_KEY=
# Bucket harus publik; default "payment-proofs" bila dikosongkan
SUPABASE_BUCKET=payment-proofs

# ---------- Seed admin pertama (npm run seed:admin) ----------
ADMIN_EMAIL=admin@klinik.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME="Admin Klinik"
ADMIN_PHONE=081234567890
